APP_NAME=ReconAI API
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql+psycopg://reconai:reconai@localhost:5432/reconai
# Optional SQLite fallback for quick offline testing:
# DATABASE_URL=sqlite:///./server/data/reconai-dev.sqlite3
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-this-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reconai-documents

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@reconai.local

GSTVERIFY_API_KEY=
GSTVERIFY_BASE_URL=https://api.gstverify.dubey.app/api/v1

OLLAMA_BASE_URL=http://localhost:11434
# Must be a model you have pulled (ollama list).
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# OCR context budget. 8192 suits a 4 GB GPU; raise only if a dense page
# fails on context size.
OCR_NUM_CTX=8192
OCR_NUM_PREDICT=2048
